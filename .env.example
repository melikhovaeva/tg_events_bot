BOT_TOKEN=replace_with_token_from_botfather
BOT_USERNAME=your_bot_username_without_at
ADMIN_PASSWORD=change-this-before-production
# Для локальной работы с админкой оставьте false. На Railway не задавайте
# переменную или укажите true — там должен быть единственный запущенный бот.
BOT_ENABLED=false
PORT=3000
# В Docker укажите /app/data — эта директория подключается как постоянный том.
DATA_DIR=./data
